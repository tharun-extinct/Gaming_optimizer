<Page x:Class="EdgeOptimizer.Settings.WinUI.ShellPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:EdgeOptimizer.Settings.Core.Models">
  <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Left" OpenPaneLength="280" SelectionChanged="OnNavigationChanged">
    <NavigationView.MenuItems>
      <NavigationViewItem Content="Dashboard" Tag="Dashboard" AutomationProperties.AutomationId="Navigation.Dashboard"><NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon></NavigationViewItem>
      <NavigationViewItem Content="Crosshair" Tag="Crosshair" AutomationProperties.AutomationId="Navigation.Crosshair"><NavigationViewItem.Icon><SymbolIcon Symbol="Target"/></NavigationViewItem.Icon></NavigationViewItem>
      <NavigationViewItem Content="Macros" Tag="Macros" AutomationProperties.AutomationId="Navigation.Macros"><NavigationViewItem.Icon><SymbolIcon Symbol="Keyboard"/></NavigationViewItem.Icon></NavigationViewItem>
      <NavigationViewItem Content="System Tweaks" Tag="SystemTweaks" AutomationProperties.AutomationId="Navigation.SystemTweaks"><NavigationViewItem.Icon><SymbolIcon Symbol="Repair"/></NavigationViewItem.Icon></NavigationViewItem>
    </NavigationView.MenuItems>
    <NavigationView.PaneFooter>
      <StackPanel Spacing="8" Padding="12"><TextBlock Text="YOUR PROFILES" Style="{StaticResource CaptionTextBlockStyle}"/><ListView ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" AutomationProperties.Name="Profiles" AutomationProperties.AutomationId="Profiles.List" MaxHeight="320"><ListView.ItemTemplate><DataTemplate x:DataType="models:ProfileWorkspace"><TextBlock Text="{x:Bind Name}"/></DataTemplate></ListView.ItemTemplate></ListView><Button Content="New profile" Command="{Binding NewProfileCommand}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="Profiles.New"/></StackPanel>
    </NavigationView.PaneFooter>
    <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Background="Transparent"/>
      <Grid Grid.Row="1" Margin="28,12,28,18"><StackPanel><TextBlock Text="{Binding CurrentPageLabel}" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="{Binding SelectedProfile.Name}" Opacity="0.72"/></StackPanel><Button Content="Activate profile" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding ActivationEnabled}" AutomationProperties.AutomationId="Profile.Activate"/></Grid>
      <ContentControl x:Name="PageHost" Grid.Row="2" Margin="28,0,28,16"/>
      <InfoBar Grid.Row="3" IsOpen="True" IsClosable="False" Severity="Informational" Message="{Binding StatusMessage}"/>
    </Grid>
  </NavigationView>
</Page>
