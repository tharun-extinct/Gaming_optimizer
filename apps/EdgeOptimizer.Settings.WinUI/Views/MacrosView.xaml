<UserControl x:Class="EdgeOptimizer.Settings.WinUI.Views.MacrosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:EdgeOptimizer.Settings.Core.Models">
  <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBox Header="Find a macro" Text="{Binding MacroSearch, Mode=TwoWay}"/><ListView ItemsSource="{Binding FilteredMacros}" SelectedItem="{Binding SelectedMacro, Mode=TwoWay}" AutomationProperties.AutomationId="Macros.List"><ListView.ItemTemplate><DataTemplate x:DataType="models:MacroDefinition"><TextBlock Text="{x:Bind Name}"/></DataTemplate></ListView.ItemTemplate></ListView><Button Content="New macro" Command="{Binding NewMacroCommand}"/></StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Action sequence" Style="{StaticResource SectionTitleStyle}"/><ListView ItemsSource="{Binding SelectedMacro.Steps}"><ListView.ItemTemplate><DataTemplate x:DataType="models:MacroStep"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Action}"/><TextBlock Grid.Column="1" Text="{x:Bind Value}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><Button Content="Add action" Command="{Binding AddActionCommand}"/></StackPanel></Border>
    <StackPanel Grid.Column="2" Spacing="16"><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Trigger &amp; playback" Style="{StaticResource SectionTitleStyle}"/><TextBox Header="Shortcut" Text="{Binding SelectedMacro.Shortcut}" IsReadOnly="True"/><Button Content="Change shortcut" Command="{Binding ChangeShortcutCommand}"/><RadioButton Content="Run once" IsChecked="True" GroupName="Playback"/><RadioButton Content="Repeat" GroupName="Playback"/><Button Content="Test macro" IsEnabled="False" ToolTipService.ToolTip="Macro worker IPC is not connected."/></StackPanel></Border><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Duplicate" Command="{Binding DuplicateMacroCommand}"/><Button Content="Delete" Command="{Binding DeleteMacroCommand}"/><Button Content="Save macro" Command="{Binding SaveMacroCommand}" Style="{StaticResource AccentButtonStyle}"/></StackPanel><TextBlock Text="{Binding FeedbackText}" TextWrapping="Wrap"/></StackPanel>
  </Grid>
</UserControl>
