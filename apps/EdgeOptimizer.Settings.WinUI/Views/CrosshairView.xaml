<UserControl x:Class="EdgeOptimizer.Settings.WinUI.Views.CrosshairView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Live preview" Style="{StaticResource SectionTitleStyle}"/><Border Grid.Row="1" Margin="0,16" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}"><TextBlock Text="＋" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Row="2" Text="{Binding ImageName}"/></Grid></Border>
    <StackPanel Grid.Column="1" Spacing="16"><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Overlay" Style="{StaticResource SectionTitleStyle}"/><ToggleSwitch Header="Enable crosshair" IsOn="{Binding OverlayEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="Crosshair.Enabled"/><Button Content="Replace PNG" Command="{Binding ReplaceImageCommand}"/><Button Content="Remove image" Command="{Binding RemoveImageCommand}"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="Position" Style="{StaticResource SectionTitleStyle}"/><NumberBox Header="Horizontal offset" Minimum="-250" Maximum="250" Value="{Binding XOffset, Mode=TwoWay}"/><NumberBox Header="Vertical offset" Minimum="-250" Maximum="250" Value="{Binding YOffset, Mode=TwoWay}"/><Button Content="Center" Command="{Binding CenterCommand}"/><Button Content="Reset" Command="{Binding ResetCommand}"/></StackPanel></Border><TextBlock Text="{Binding FeedbackText}" TextWrapping="Wrap"/></StackPanel>
  </Grid>
</UserControl>
