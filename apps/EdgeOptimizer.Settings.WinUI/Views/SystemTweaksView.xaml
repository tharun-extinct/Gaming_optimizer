<UserControl x:Class="EdgeOptimizer.Settings.WinUI.Views.SystemTweaksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:EdgeOptimizer.Settings.Core.Models">
  <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="16"><Border Style="{StaticResource CardStyle}"><ToggleSwitch Header="Fan speed boost" OffContent="Default cooling policy" OnContent="Maximum while profile is active" IsOn="{Binding FanBoostEnabled, Mode=TwoWay}"/></Border><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Apps to close" Style="{StaticResource SectionTitleStyle}"/><TextBox PlaceholderText="Search running apps" Text="{Binding ProcessFilter, Mode=TwoWay}"/><TextBlock Text="{Binding SelectionSummary}"/><ListView ItemsSource="{Binding FilteredProcesses}"><ListView.ItemTemplate><DataTemplate x:DataType="models:ProcessItem"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"/><TextBlock Grid.Column="1" Text="{x:Bind Name}"/><TextBlock Grid.Column="2" Text="{x:Bind Cpu}"/><TextBlock Grid.Column="3" Text="{x:Bind Memory}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border></StackPanel>
    <StackPanel Grid.Column="1" Spacing="16"><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Cleanup actions" Style="{StaticResource SectionTitleStyle}"/><CheckBox Content="Recycle Bin" IsChecked="{Binding RecycleBinEnabled, Mode=TwoWay}"/><CheckBox Content="Browser cache" IsChecked="{Binding BrowserCacheEnabled, Mode=TwoWay}"/><InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Message="Runner approval is required before any cleanup runs."/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Safety" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Protected and ambiguous processes are always excluded." TextWrapping="Wrap"/><Button Content="View protected list" Command="{Binding ProtectedListCommand}"/></StackPanel></Border><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}"/><Button Content="Save changes" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}"/></StackPanel><TextBlock Text="{Binding FeedbackText}" TextWrapping="Wrap"/></StackPanel>
  </Grid>
</UserControl>
