<UserControl x:Class="EdgeOptimizer.Settings.WinUI.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Spacing="16">
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Apps selected"/><TextBlock Text="{Binding SelectedAppCount}" Style="{StaticResource SubtitleTextBlockStyle}"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Crosshair"/><TextBlock Text="{Binding CrosshairStatus}" Style="{StaticResource SubtitleTextBlockStyle}"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Macro trigger"/><TextBlock Text="{Binding MacroShortcut}" Style="{StaticResource SubtitleTextBlockStyle}"/></StackPanel></Border>
      <Border Grid.Column="3" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Readiness"/><TextBlock Text="{Binding ReadinessLabel}" Style="{StaticResource SubtitleTextBlockStyle}"/></StackPanel></Border>
    </Grid>
    <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16"><TextBlock Text="Ready to optimize" Style="{StaticResource SectionTitleStyle}"/><ProgressBar Value="72"/><Button Content="Optimize &amp; launch" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" ToolTipService.ToolTip="Runner IPC is not connected." AutomationProperties.AutomationId="Dashboard.Optimize"/></StackPanel></Border>
    <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Quick actions" Style="{StaticResource SectionTitleStyle}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open crosshair" Command="{Binding NavigateCommand}" CommandParameter="Crosshair"/><Button Content="Edit macro" Command="{Binding NavigateCommand}" CommandParameter="Macros"/><Button Content="System tweaks" Command="{Binding NavigateCommand}" CommandParameter="SystemTweaks"/></StackPanel></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
