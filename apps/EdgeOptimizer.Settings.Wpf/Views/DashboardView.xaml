<UserControl x:Class="EdgeOptimizer.Settings.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="4,0,4,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Profile status" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="Preview" Foreground="{StaticResource SuccessBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Apps selected" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="3" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Crosshair" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="Enabled" Foreground="{StaticResource SuccessBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource CardBorder}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Macro trigger" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="Ctrl + F8" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Ready to optimize" Style="{StaticResource SectionTitleText}"/>
                        <Grid Grid.Row="1" Margin="8,22,8,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="154" Height="154" CornerRadius="77" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="5"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ready" Foreground="{StaticResource SuccessBrush}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="✓  Profile configured" FontSize="15" Margin="0,10"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <TextBlock Text="✓  Crosshair loaded" FontSize="15" Margin="0,10"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <TextBlock Text="✓  Macro assigned" FontSize="15" Margin="0,10"/>
                            </StackPanel>
                        </Grid>
                        <Button Grid.Row="2" Content="Optimize &amp; launch" Style="{StaticResource PrimaryButton}" Height="54"
                                IsEnabled="False" ToolTip="Runner IPC is not connected."/>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Session snapshot" Style="{StaticResource SectionTitleText}" Margin="0,0,0,16"/>
                            <Border Style="{StaticResource InsetBorder}" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU"/>
                                    <TextBlock Grid.Column="1" Text="18%" FontSize="20" FontWeight="SemiBold"/>
                                    <ProgressBar Grid.Column="2" Value="18" Height="9" Foreground="{StaticResource AccentBrush}" Background="#243444"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource InsetBorder}" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Memory"/>
                                    <TextBlock Grid.Column="1" Text="42%" FontSize="20" FontWeight="SemiBold"/>
                                    <ProgressBar Grid.Column="2" Value="42" Height="9" Foreground="{StaticResource AccentBrush}" Background="#243444"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource InsetBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Apps running"/>
                                    <TextBlock Grid.Column="1" Text="86" FontSize="20" FontWeight="SemiBold"/>
                                    <ProgressBar Grid.Column="2" Value="78" Height="9" Foreground="{StaticResource AccentBrush}" Background="#243444"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Quick actions" Style="{StaticResource SectionTitleText}" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Open crosshair" Style="{StaticResource SecondaryButton}" Tag="Crosshair" Click="QuickAction_Click"/>
                                <Button Grid.Column="2" Content="Edit macro" Style="{StaticResource SecondaryButton}" Tag="Macros" Click="QuickAction_Click"/>
                                <Button Grid.Column="4" Content="Run cleanup" Style="{StaticResource SecondaryButton}" Tag="SystemTweaks" Click="QuickAction_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,14,0,0" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Fortnite profile" Style="{StaticResource SectionTitleText}" Margin="0,0,28,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="3 apps close on activation"/>
                        <TextBlock Text="  •  " Style="{StaticResource MutedText}"/>
                        <TextBlock Text="Fan speed boost enabled"/>
                        <TextBlock Text="  •  " Style="{StaticResource MutedText}"/>
                        <TextBlock Text="2 cleanup actions"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="System tweaks  →" Style="{StaticResource AccentOutlineButton}" Tag="SystemTweaks" Click="QuickAction_Click"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
